# Template para credenciais do usuário readonly do PostgreSQL via SSH tunnel.
# O banco fica em VPS remota; a conexão é feita abrindo um tunnel SSH local.
#
# Copie este arquivo para .claude/db-readonly.env e preencha com as credenciais reais.
# O arquivo .claude/db-readonly.env está no .gitignore — NUNCA commitar com valores reais.
#
# Para criar o usuário readonly no banco, consultar a conversa no Claude sobre
# "criar usuário readonly no PostgreSQL" (schemas public e admin).
#
# Fluxo de conexão:
#   ssh -L DEV_SSH_TUNNEL_PORT:DEV_DB_HOST:DEV_DB_PORT DEV_SSH_USER@DEV_SSH_HOST
#   psql -h 127.0.0.1 -p DEV_SSH_TUNNEL_PORT -U DEV_DB_USER -d DEV_DB_NAME
#
# SENHAS COM CARACTERES ESPECIAIS (# $ ! & espaço etc):
#   Use aspas simples — preservam tudo literalmente:
#     DEV_DB_PASS='minha#senha$especial!'
#   Se a senha contém aspas simples ('), escape assim:
#     DEV_DB_PASS='parte1'\''apostrofe'\''parte2'
#   Nunca use aspas duplas — $ e ! serão expandidos pelo shell.

# ──────────────────────────────────────────
# Development
# ──────────────────────────────────────────

# VPS de desenvolvimento
DEV_SSH_HOST=
DEV_SSH_PORT=22
DEV_SSH_USER=
DEV_SSH_KEY=~/.ssh/id_rsa

# Porta local que o tunnel vai expor (deve estar livre na máquina local)
DEV_SSH_TUNNEL_PORT=5433

# Endereço do PostgreSQL visto de DENTRO da VPS (normalmente 127.0.0.1)
DEV_DB_HOST=127.0.0.1
DEV_DB_PORT=5432
DEV_DB_NAME=quantix_db
DEV_DB_USER=quantix_readonly
DEV_DB_PASS=

# ──────────────────────────────────────────
# Production
# ──────────────────────────────────────────

# VPS de produção
PROD_SSH_HOST=
PROD_SSH_PORT=22
PROD_SSH_USER=
PROD_SSH_KEY=~/.ssh/id_rsa

# Porta local diferente para não conflitar com dev
PROD_SSH_TUNNEL_PORT=5434

# Endereço do PostgreSQL visto de DENTRO da VPS de prod
PROD_DB_HOST=127.0.0.1
PROD_DB_PORT=5432
PROD_DB_NAME=quantix_db
PROD_DB_USER=quantix_readonly
PROD_DB_PASS=
